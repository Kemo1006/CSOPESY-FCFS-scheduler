{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build emulator",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-g",
                "-Wall",
                "-Wextra",
                "-pthread",
                "-static",
                "${workspaceFolder}\\src\\main.cpp",
                "${workspaceFolder}\\src\\scheduler.cpp",
                "-o",
                "${workspaceFolder}\\build\\emulator.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
